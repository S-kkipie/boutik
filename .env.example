# Copy to .env to override defaults. Everything works without a .env file.
# Regtest only: coins have no value. Never put mainnet keys or real funds here.

BOUTIK_PORT=8000
BOUTIK_DEMO_MODE=true
BOUTIK_SHOP_NAME=Boutique Keur Daba
# Demo PIN shown on the login screen. Leave empty to have the merchant create one on first run.
BOUTIK_PIN=1234
# Public base URL used in ardoise payment links shared by WhatsApp. Empty = derived from the request.
BOUTIK_PUBLIC_URL=
# Set to true behind HTTPS (required for a public deployment).
BOUTIK_COOKIE_SECURE=false
# auto = live BTC/EUR (mempool.space, CoinGecko) with fallback; fixed = never call out.
BOUTIK_RATE_SOURCE=auto

# Optional: enables the Claude assistant. Without it the offline French parser is used.
ANTHROPIC_API_KEY=
BOUTIK_ASSISTANT_MODEL=claude-opus-5-5

# Internal regtest RPC credentials (bitcoind is never exposed outside the Docker network).
BITCOIN_RPC_USER=boutik
BITCOIN_RPC_PASSWORD=regtest-only-not-a-secret
