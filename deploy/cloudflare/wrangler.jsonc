{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Public demo of Boutik: one container instance running regtest bitcoind + 2 LND + the app.
  // The instance sleeps after 30 min idle and wakes with a fresh regtest chain and demo data.
  "name": "boutik-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BoutikDemo",
      "image": "../Dockerfile.allinone",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOUTIK", "class_name": "BoutikDemo" }]
  },
  "exports": {
    "BoutikDemo": { "type": "durable-object", "storage": "sqlite" }
  }
}
